# ローカル開発用（.env.local にコピーして使う）。docker compose up -d で起動するPostgresに接続する
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phrasal_verb_db?schema=public"

# 認証トークンの署名用。長いランダムな文字列にする
JWT_SECRET="change-me-to-a-long-random-string"

# 管理者アカウントのシード用（npm run seed:admin でのみ使用）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# 別のAPIサーバーを使う場合だけ設定（通常は不要。空なら同じドメインの /api を使う）
# NEXT_PUBLIC_API_BASE_URL=
